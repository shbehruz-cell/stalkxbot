# BotFather token. Never commit a real token.
BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE

# SQLite database file path
DATABASE_PATH=data/bot.sqlite3

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Maximum characters from message text included in notifications
MAX_MESSAGE_CHARS=2500

# Legacy setting retained for compatibility; only edits and deletions trigger notifications.
OWNER_NOTIFY=true
